<icecast>
    <location>Copenhagen, Denmark</location>
    <admin>admin@reservatet.fm</admin>
    <hostname>stream.reservatet.fm</hostname>

    <limits>
        <clients>2000</clients>
        <sources>10</sources>
        <queue-size>4194304</queue-size>
        <client-timeout>90</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>30</source-timeout>
        <burst-size>262144</burst-size>
    </limits>

    <authentication>
        <source-password>rsvt_source_secret_2026</source-password>
        <relay-password>rsvt_relay_secret_2026</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>rsvt_admin_secret_2026</admin-password>
    </authentication>

    <listen-socket>
        <port>8000</port>
        <bind-address>127.0.0.1</bind-address>
    </listen-socket>

    <!-- Mount for 320k Radio.cloud live stream -->
    <mount type="normal">
        <mount-name>/live.mp3</mount-name>
        <burst-size>262144</burst-size>
        <queue-size>4194304</queue-size>
    </mount>

    <!-- Native C-Relay Mount for Sonos: Directly relayed from Radio.cloud with zero transcode drift -->
    <mount type="normal">
        <mount-name>/sonos.mp3</mount-name>
        <burst-size>262144</burst-size>
        <queue-size>4194304</queue-size>
    </mount>

    <!-- Mount for Bloede Boelger stream -->
    <mount type="normal">
        <mount-name>/bloede.mp3</mount-name>
        <burst-size>262144</burst-size>
        <queue-size>1048576</queue-size>
    </mount>

    <relay>
        <local-mount>/live.mp3</local-mount>
        <on-demand>false</on-demand>
        <upstream type="normal">
            <uri>http://cdn01.radio.cloud:80/RES-COP-CINURAUDIO01</uri>
            <relay-shoutcast-metadata>false</relay-shoutcast-metadata>
        </upstream>
    </relay>

    <relay>
        <local-mount>/sonos.mp3</local-mount>
        <on-demand>false</on-demand>
        <upstream type="normal">
            <uri>http://cdn01.radio.cloud:80/RES-COP-CINURAUDIO01</uri>
            <relay-shoutcast-metadata>false</relay-shoutcast-metadata>
        </upstream>
    </relay>

    <relay>
        <local-mount>/bloede.mp3</local-mount>
        <on-demand>false</on-demand>
        <upstream type="normal">
            <uri>http://stream.radiojar.com/4hge3m401bpwv</uri>
            <relay-shoutcast-metadata>false</relay-shoutcast-metadata>
        </upstream>
    </relay>

    <paths>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <reportxmldb>/usr/share/icecast2/report-db.xml</reportxmldb>
        <alias source="/" destination="/live.mp3"/>
        <alias source="/stream.mp3" destination="/live.mp3"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>false</chroot>
    </security>
</icecast>
